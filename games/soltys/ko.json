{
 "_": "Soltys 한글 자막. t=SAY ref→한글(\\n은 줄바꿈), names=스프라이트 이름(SAY 밖), skip=의도적 미번역",
 "t": {
  "40": "다음에 또 봐요!",
  "41": "축하합니다! 오늘은 여기까지예요. 다음에 또...",
  "101": "정보",
  "102": "말풍선",
  "105": "음량 조절",
  "200": "정말 그만두시겠습니까?",
  "201": "이 게임 이제 지겹다!",
  "202": "앗! 계속할래요!",
  "601": "이건 좋은 생각이 아닌 것 같은데.",
  "602": "아야! 머리를 좀 쓰는 게 낫겠어.",
  "603": "휙! 뭔가 고약한 게 씌었나 보군.",
  "604": "안 돼. 그쪽으론 못 가.",
  "605": "혼자 안 되면 누구한테 도움을 청해 보든가.",
  "606": "더는 할 수 있는 게 없어...",
  "607": "이번 일로 뭐라도 배웠길 바라네.",
  "608": "영 찜찜한걸. 뭐라 해야 할지 모르겠군.",
  "609": "뭘 해야 할지 모르겠다고? 기운 내! 나도 몰라.",
  "610": "있잖아, 좀 쉬는 게 좋겠어.\n잠이라도 자든가...",
  "611": "이렇게 웃긴 소린 오랜만이군!",
  "612": "그래서, 나더러 어쩌라고?",
  "613": "이거 쓸 데 있으려나? 난 필요 없는데.",
  "614": "반대쪽에서 해 보는 건 어때?",
  "615": "달리 할 일이 없나 보군?",
  "616": "그럼 자네가 대신 해 보든가.\n생각만큼 쉽지 않다는 걸\n알게 될 거야!",
  "617": "어이구, 난 엄두도 안 나!",
  "618": "나더러 멍청하다더니... 그게 뭐요, 방아쇠 양반?",
  "619": "더 나빠지면 어쩌라고?",
  "620": "그건 두 번은 안 하겠어!",
  "671": "거긴 안 갈 거야!",
  "681": "이 거리에선 아무것도 못 해!",
  "691": "그걸 어디다 꽂으라는 거요, 잘난 양반?",
  "777": "이런 무례한! 이런 행실 하고는! 이 촌뜨기야!\n그 손가락 어디다 꽂아야 할지 알려줄까?",
  "1001": "왜 울타리에 앉아 있나?",
  "1002": "지붕 위는 몸 지키기엔 영 나쁘지.",
  "1003": "자네가 개구리 왕자인가?",
  "1004": "꺼져, 이 변태야!\n마누라가 질리기라도 했나?\n여러분! 이 미친놈이 잔디를 밟고 있어요!",
  "1005": "레온 없이는 돌아올 생각도 마라, 이 얼간아!",
  "1006": "저도 죽고 싶진 않습니다!\n무슨 수를 써서라도 레온을 데려오죠.",
  "1007": "고맙지만 방금 먹었어.",
  "1008": "이걸 가슴 장식으로 달 순 없지.",
  "1009": "애초에 양복도 없는걸.",
  "1011": "조심해! 놓지 않으면 콧수염을 뽑아 버린다!",
  "1012": "야! 놓지 않으면 눈알을 할퀴어 버린다!",
  "1015": "이 기막힌 맛은 다들 알지, 응?",
  "1016": "이거 한 모금이면 울렁거리는 속이 가라앉지.",
  "1017": "아무튼, 그래... 마음에 들어!",
  "1018": "와! 훌륭한데!",
  "1040": "개집 처음 봐?",
  "1050": "꼬르륵 꼬르륵! 첨벙!",
  "1060": "으르렁! 멍멍멍!",
  "2001": "이제야 오는군. 어디 갔었나?\n이 카드 받게, 어제 그 친구들이 두고 갔어.",
  "2002": "쓱쓱!\n쓱쓱!\n쓱쓱!",
  "2003": "잠깐은 가져가도 되네만\n곧 필요하니 꼭 돌려주게.",
  "2004": "어이, 운전사 양반!",
  "2005": "귀찮게 굴지 마. 일하는 거 안 보여?",
  "2006": "버스가 맨날 고장인데 정류장이 무슨 소용이야?",
  "2007": "누가 이 커다란 성냥개비들을 여기 꽂아 놨어?",
  "2008": "이만한 성냥갑 옆면을 어디서 구하지?",
  "3001": "이보에 치구, 어 지 조 어떠케 해 어. 삐삐 또 삐삐!",
  "3002": "이보게 친구, 저 쥐 좀 어떻게 해 주게. 삑삑대고 또 삑삑대!",
  "3003": "고맙네!\n답례로 이 소시지를 받게!",
  "3004": "어림없어! 저 과부 죽은 남편이 얼마 전에 그러다 갔지.",
  "3005": "양파를 매일 먹으면 정력이 달아난다더군.",
  "3006": "과부랑 그 돈에서 손 떼, 안 그러면 물어 버린다!",
  "3007": "난 여기가 좋아. 아무 데도 안 가.",
  "3008": "저 자본주의 기계 좀 보게.\n광고는 죄다 거짓부렁이야!",
  "3009": "야옹 야옹!",
  "3014": "찍찍!",
  "3021": "아야! 엄청 차갑네. 손이 그대로 얼어붙겠어!",
  "4001": "그르릉 그르릉!",
  "4002": "멍멍멍! 으르렁!",
  "4003": "거시기가 없으면 못 써!",
  "4004": "배로 쓸 만하겠는데...",
  "4005": "배는 무슨. 노가 없잖아.",
  "4006": "노로 쓸 만하겠는데...",
  "4007": "노는 무슨. 배가 없잖아.",
  "4008": "저 정신 나간 것들이... 좋은 건 죄다 마셔 버렸군.",
  "4009": "세상모르고 자는군...",
  "4010": "어이 자네! 혹시 내 헛간에 들렀던 건 아니겠지?",
  "4011": "차 한잔 하고 싶은데...",
  "4012": "주전자가 좀 식었군...",
  "5001": "사, 삼촌이 지, 지하 모임을 찾겠다고\n나섰다가 결국 광장을 파헤친 거\n기억나?",
  "5002": "저 연기 어디서 나는 거야? ... 불이야!\n아, 자네군. 무슨 일인가?",
  "5003": "바람 없고 화창한 날엔 담배 한 대가 좋지.",
  "5004": "저게 뭐야? 그래픽 담당이 꽤나 창의적이었나 보군!",
  "5005": "말이 안 되는데...",
  "5006": "바람깨나 일으킬 물건 같은데...",
  "6001": "주인에게 한 방, 마님에게 한 방.",
  "6002": "하트의 여왕이 타르트를 구웠네.",
  "6003": "하트는 전부 내려놔!",
  "6004": "하트의 잭이 타르트를 훔쳤네.",
  "6005": "다이아몬드는 노름꾼의 가장 좋은 친구지.",
  "6006": "클로버는 몽땅 술집으로!",
  "6007": "스페이드를 한 번 더, 샘!",
  "6008": "무엇이 쳐들어오나...?",
  "6009": "...스페이드 에이스!",
  "6010": "제때 낸 10은 동전 한 닢을 아껴 주지.",
  "6011": "카드에 운이 좋으면...",
  "6012": "...사랑엔 젬병이라!",
  "6013": "퀸을 쳐라! 킹은 보이지 않는다.",
  "6014": "조심들 하시게. 말하는 탁자는 없는 법.",
  "6015": "10으로는 모두를 만족시키기 어렵지.",
  "6016": "스페이드를 내는 자에겐 칼이 필요 없다.",
  "6017": "다이아몬드는 영원하다. 지금 아니면 영영 없다.",
  "6018": "스페이드가 셋이면 뒤집어진다.",
  "6101": "고맙네 촌장! 우리 패에서 빠진 게 그 카드였어.",
  "6102": "아야!",
  "6103": "미안!",
  "6104": "방해하지 말게. 한창 노는 중이야!\n줄 게 있으면 탁자에 올려놓게.",
  "6105": "이런! 너무 어려워.\n도움 없인 못 하겠어!",
  "6106": "자물쇠가 걸려 있어.",
  "6107": "잠겨 있어.",
  "6201": "엉덩이 좀 치워, 이 더러운 걸레야!",
  "6202": "멋진 전구인데!",
  "6203": "그걸 어디다 끼우면 좋을까, 응?",
  "6204": "자 여러분, 이 친구 좀 도와줍시다, 그렇죠?",
  "6205": "이거 자네 카드 아닌가?",
  "7001": "신부님이 포도주를 꽁꽁 잠가 두셔서...\n나한테 뭐 좀 없나? 그러니까... 한두 모금쯤?",
  "7002": "기막힌 술이군! 내가 그리던 바로 그 맛이야.\n신부님 찾나? 제의실에서 일하고 계셔.",
  "7003": "이건 쉰 오줌이잖아! 날 뭘로 보나, 촌장?\n이건 무너진 저택의 거지한테나 어울리겠군.",
  "8001": "이가 지독하게 아파!",
  "8002": "빛이 더 있어야겠군. 어디 봅시다...",
  "8003": "됐다! 이제 살 것 같네. 정말 고마워!",
  "8004": "별말씀을! 저 말을 조심하게!\n성질이 아주 사나워,\n특히 파리가 붙으면 더해.",
  "8005": "싫어. 나도 그렇게 멍청하진 않아! 얻어터지고 싶진 않다고.",
  "8006": "약아빠졌군!",
  "9001": "아이참! 그만하게. 악마가 꼬리로\n간질이는 꿈을 꾸고 있었단 말이야.",
  "9002": "영감님! 저 수탉 좀 치워요.\n길을 막고 있잖아요!",
  "9003": "치울 수 있으면 치워 보게. 배가 고파서 안 비켜.\n먹이를 주면 비켜 줄지도 모르지.",
  "9004": "저 미친 놈한테 무슨 먹이를 구해다 주지?\n이 근방은 죄다 먹어 치웠는데.",
  "9005": "빨간 사탕무 밭에서 감자벌레를 좀 잡아 오게,\n이 양동이를 쓰고.",
  "9006": "우웩! 저건 손도 안 댈 거야.",
  "9007": "하루 종일 저걸 쫓아다니라는 거야?",
  "9008": "요즘은 제대로 된 먹이가 유행이라더군.",
  "9010": "음냐-쯥!",
  "9011": "훠이, 훠이! 저리 가!",
  "9012": "꼬꼬댁 꼬꼬!",
  "9101": "뻐꾹! 뻐꾹!",
  "9201": "살아 있는 닭 모이.",
  "10001": "대체 누가 이리 소란이야?\n꺼지지 않으면 그 못난 상판을 때려 줄 테다! 진심이야.",
  "10002": "그리고 비웃지 마, 조! 가서 벌레나 잡아 오는 게 나을걸.",
  "10003": "도와드릴까요? 감자벌레를 좀 잡고 싶은데요.",
  "10004": "그래! 해빗 영감네 근처 덤불 봤나?\n그게 우리 밭이야.",
  "10005": "아직 다 먹혀 버리지 않았다면 말이지.",
  "10011": "물론이지!",
  "10015": "난 사탕무 싫어!",
  "11001": "요즘 나무가 참 빨리 자라는군.\n지난주만 해도 꼭대기에 손이 닿았는데...",
  "11002": "여기 편지가 하나 있네. 누가 주소를 안 적었어.\n자넨 발이 넓으니 가져가서 좀 도와주게.",
  "11003": "저런 괴물이! 날 싫어하는 모양이군.",
  "11004": "텅 빈 것 같은데!",
  "11005": "벌들이 사라졌어!",
  "11006": "월세를 안 냈나 보지?",
  "11007": "꽥꽥!",
  "12001": "뻐꾸기시계가 고장 나더니 지독한 냄새까지 나기 시작했어!",
  "12002": "이 새 뻐꾸기면 되겠지!\n답례로 뭐라도 가져가게.",
  "12003": "먼저 그 거시기를 구해 와야 해!",
  "12004": "그건 건드리지 마. 내 게 아니야. 힐다한테 빌린 거라고.",
  "12005": "두루 여행을 다니면 보는 눈이 트이는 법이지.",
  "13001": "음, 음 음. 음음음 음,\n음 음음 음음 음 음 음음음.",
  "13002": "그래, 아들아. 그걸 전해 주게,\n난 울타리로 돌아가겠네.",
  "13003": "신의 축복이 있기를, 아들아. 결혼식에서 보세.",
  "13005": "신부님, 결혼식이 엉망이 돼서 죄송합니다.\n이번 일요일에 다시 해 보면 어떨까요?",
  "13006": "죄송한데, 못 알아들었습니다.",
  "13007": "음-음!",
  "13008": "내가 우표 수집가로 보이나?",
  "13009": "목소리가 너무 낮아! 한 마디도 못 알아들었어.",
  "13010": "어이쿠 세상에!",
  "13011": "천만의 말씀!",
  "14001": "낫이 총 맞았다는 소식 있소?",
  "14002": "낮이라고?",
  "14003": "낫이 총 맞았다니까! 숏하고 결투하다가.",
  "14004": "아니오.",
  "14005": "아니라고?",
  "14006": "아니!",
  "14007": "다른 최신판은 없소?",
  "14008": "아직 안 들어왔소.",
  "14009": "숏 소식은 없소?",
  "14010": "없어!",
  "14011": "3즈워티 50입니다.",
  "14012": "여기 있습니다.",
  "14013": "거스름돈이오.",
  "14014": "고맙소.",
  "14015": "12즈워티 70입니다.",
  "14016": "천만에요.",
  "14021": "뭐요? 글씨도 못 읽나?",
  "14022": "꺼져, 안 그러면 한 대 맞는다!",
  "14023": "난 안전한 쪽이 좋아.",
  "15001": "사진은 어디 있죠?",
  "15002": "무슨 사진?",
  "15003": "여기 보세요. 신청서는 괜찮은데 사진이 빠졌어요.",
  "15004": "무슨 신청서?",
  "15005": "따님 거예요. 여권을 신청하셨거든요.\n그러니... 사진 없으면 여권도 없습니다.",
  "15006": "제가 무척 바빠서요. 다음에 다시 오시겠어요?",
  "15007": "007, 거기 있나?",
  "16001": "안녕하쇼, 촌장!",
  "16002": "안녕, 힐다! 요즘 어떻게 지내?",
  "16003": "심심해 죽겠어... 우리... 벗기 놀이나 할까?",
  "16004": "안 될 거 있나?",
  "16005": "저 양반은 늘 아쉬운 게 많지.",
  "16006": "좋아, 재미있겠는데!",
  "16007": "시작이다! 돌아서서 바지 내려!",
  "16008": "누가 때렸게?",
  "16009": "뭐? 내가 이겼다! 벗어, 아가씨!",
  "16010": "탁자에 가서 앉아.",
  "16011": "어... 난 그냥 서 있는 게 낫겠어.",
  "16012": "한 판 더 할래?",
  "16021": "그 신맛은 질색이야!",
  "17001": "으! 지독한 냄새! 지나갈 수가 없군.",
  "17002": "촌장인가? 빨리! 새 신문 좀 가져다주게.",
  "17003": "이 신문 좋군! 근데 왜 이리 차갑지?",
  "17004": "사진사랑 밤새 퍼마셨지.\n우유가 없었으면 나도 저 꼴이 났을 거야.",
  "17005": "저 눈에 악마가 들었군!",
  "17006": "자네 엉덩이는 안 훔쳐볼 테니!",
  "18001": "촌장, 이보게! 내 산호 목걸이 못 봤나?",
  "18002": "그래, 내 목걸이야! 답례로 뭘 줄까?\n이 풀은 러비지라고 하는데, 누군가의 마음에\n불을 붙이는 데 최고지. 사랑의 묘약 몇 방울이면\n충분할 거야!",
  "18003": "손 치워! 난 그런 여자가 아니야.",
  "18004": "야오옹 야오옹!",
  "18005": "여자 옷을 입으니\n묘하게 흥분되는걸...",
  "18006": "좀 민망하군.",
  "19001": "음메 음메 음메!",
  "19002": "고장 난 모양이군.",
  "19003": "농담해? 거기에 손 안 댈 거야!",
  "19004": "우유가 이리 싼데 소를 왜 사?",
  "19005": "이제 바구니를 채워 보시지!",
  "19006": "어미는 착하고 송아지는 사납지.",
  "19007": "바구니 한 개 반을 채워라!",
  "19008": "소는 제 꼬리 값을 안다네.",
  "19009": "바구니를 채우고 자리를 비켜라!",
  "20001": "돈 걸고 \"십팔\" 한 판 어떤가?",
  "20002": "아쉽게도 신부님이 주사위를 가져가 버렸어.",
  "20003": "내가 이겼다! 내가 이겼어!",
  "20004": "운도 좋군! 잔돈이나 가져가, 지폐는 필요 없잖아.",
  "20005": "축하하네! 지폐는 자네 거야, 잔돈은 필요 없겠지.",
  "20006": "저기 봐! 염소가 내 딴 돈을 먹어 버렸어!",
  "20007": "어... 다들 늘 그렇게 말하지!",
  "20010": "좋아, 굴려 보게 촌장!",
  "20011": "이제 내 차례야!",
  "20012": "이번엔 내 거다!",
  "20021": "쉿! 촌장, 이 바보 광대야!\n주사위가 ALT되어 있는 거 안 보여?",
  "20022": "못 알아듣겠나?\n굴릴 때 ALT 키를 누르고 있으라고!",
  "21001": "머리에 한 방 박고 잠자리로!",
  "21002": "예, 예의 좀 차, 차리게...",
  "21003": "아 그만하고 날 좀 내버려 둬!",
  "21004": "왜... 왜? 그만 때려!",
  "21005": "어느 판사님 말씀이 있지:\n\"술은 절대 섞어 마시지 마라.\"",
  "21006": "매, 맹세해! 다, 다신 한 방울도 안 마셔.",
  "21007": "뭐? 레온 사진?\n필름 원판밖에 없는데.",
  "21008": "페기 수가 좋아하겠군!",
  "21011": "사진에 얼굴이 없잖아!",
  "21012": "젠장! 카메라를 들 몸 상태가 아니야.",
  "21013": "좋아, 이건 제대로 나왔군.",
  "21014": "나, 난 어, 언제나 최선을 다하지.",
  "21015": "손 치워, 이 멍청아!\n난 어린 왕자를 기다리는 중이라고!",
  "21016": "이런! 이 친구가 여기까지 올 리 없다더니!\n누가 기획자 좀 불러서 게임을 끝내라고 해.",
  "21017": "지금이 바로 그때지!",
  "21018": "왜 학교에 안 갔니?",
  "21019": "학교 다녀 봐야 소용없어. 배웠다고\n뭐가 달라? 사위는 어디 있는데?",
  "21020": "오늘은 수업 없어요, 선생님들이 안 나오셨거든요.",
  "21021": "마음만 있다면야...",
  "21022": "그만 꼬집어요, 아버지! 아버지도 그런 거예요..?",
  "22001": "훌륭한 약초로군! 근사한 묘약이 되겠어.\n그동안 저 돼지 좀 어떻게 해 주게.",
  "22002": "아놀드를 꽤 빨리 처리했군.\n묘약이 다 됐네. 이 병을 가져가게.",
  "22003": "꿀꿀꿀!",
  "22004": "고마워!",
  "22005": "이봐요 할멈! 저놈이 잘 벼린 쇠붙이를\n좋아한다는 말은 안 했잖아요.",
  "22006": "진작 그렇게 했어야지!",
  "22007": "자, 아리따운 부인. 그 풀로 한 모금이라도 뽑아낼 수 있겠소?",
  "23001": "소용없어! 자물쇠가 걸려 있잖아!",
  "24001": "꺼져! 이 늙은 얼간아!",
  "24002": "안녕하십니까, 사랑하는 장인어른!",
  "24003": "자, 따라오게!\n사람들이 교회에서 기다리고 있어.",
  "24004": "포도주 한 모금이면 바람도 내 것이라던데.",
  "24005": "사탕 따위 집어치워! 밀주가 최고지!",
  "25001": "그래, 그래... 화면만 끄지 마!",
  "25002": "자, 우리 꽃 같은 공주님!\n세월은 빠르고, 이제 시집갈 때가 됐구나.",
  "25003": "결정이 쉽지 않구나,\n그 많은 사내 중에 제대로 된 놈을 고르자니...",
  "25004": "사실을 말하자면... 그럴듯한 놈은 하나도 없었지만...",
  "25005": "그래서 우리가 신랑을 골랐다!\n이 사진을 보렴. 저 사람이야. 어떠냐?",
  "26001": "신부는 레온을 남편으로 맞이하겠습니까?",
  "26002": "어... 네, 그러겠습니다.",
  "26003": "레온은 촌장의 딸을 아내로 맞이하겠습니까?",
  "26004": "어... 아아!",
  "26005": "어... 이이!",
  "26006": "어... 우우!",
  "26007": "누가 두꺼비집 좀 봐 주시겠어요?",
  "26011": "이런 기막힌 일이! 씨, 씨...",
  "26012": "...씨알도 안 먹히는군! 레온이 냅다 줄행랑쳤어!",
  "26013": "그럼 저 이제 가도 되나요?",
  "26020": "레오오온! 기다려! 나도 같이 갈래!",
  "28001": "다 네 탓이야!\n왜 못 붙잡았어?",
  "28002": "당장 찾아서 데려와! 지금 즉시 가라고!"
 },
