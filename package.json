{
  "name": "scummvm-web-v8",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ScummVM (GPLv3) Emscripten build + DOM Korean subtitle layer — Lure of the Temptress (lure), Soltys (cge)",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "engine:build": "bash engine-patches/build.sh",
    "game:fetch": "bash tools/fetch-game.sh",
    "font:fetch": "bash tools/fetch-font.sh",
    "data:stage": "bash tools/stage-data.sh",
    "i18n:check": "node tools/i18n-check.mjs",
    "strings:dump": "node tools/dump-strings.mjs",
    "names:dump": "python3 tools/dump-cge-names.py",
    "smoke": "node tools/smoke.mjs",
    "smoke:boot": "node tools/smoke-boot.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@agent8/gameserver": "^1.10.2",
    "@verse8/ads": "^0.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
